#!/bin/sh
set -eu

collector_url=${{"{"}}{{ .EnvVarPrefix }}_HOOK_COLLECTOR_URL:-{{ .CollectorURLQuoted }}}
hook_secret={{ .HookSecretQuoted }}
event_name=$1
payload_file=$(mktemp "${TMPDIR:-/tmp}/{{ .TmpPrefix }}-hook.XXXXXX")
trap 'rm -f "$payload_file"' EXIT INT TERM

cat >"$payload_file"

set -- -H "Content-Type: application/json" -H "{{ .EventHeader }}: $event_name" \
  -H "X-Rig-Hook-Secret: $hook_secret" -H "{{ .HookPIDHeader }}: $$"
if [ -n "${TMUX_PANE:-}" ]; then
  set -- "$@" -H "{{ .TmuxPaneHeader }}: $TMUX_PANE"
fi
if [ -n "${TMUX:-}" ]; then
  set -- "$@" -H "{{ .TmuxHeader }}: $TMUX"
fi

if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 2 -X POST "$@" --data-binary @"$payload_file" "$collector_url"; then
  exit 0
fi
exit 0
